# Copy this file to ".env" and fill in your own local values.
# Do NOT commit your real .env file.
DATABASE_URL="postgresql://toktickit:toktickit@localhost:5432/toktickit?schema=public"
PORT=3000
# Lab 3: the Vite dev server's origin. CORS must echo this back exactly
# (not "*") because the browser refuses credentialed (cookie-bearing)
# requests against a wildcard Access-Control-Allow-Origin.
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development